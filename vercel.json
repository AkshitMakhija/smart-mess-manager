{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=()"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/live-crowd",
      "destination": "/demo/live-crowd.html"
    },
    {
      "source": "/camera",
      "destination": "/demo/camera.html"
    },
    {
      "source": "/student-dashboard",
      "destination": "/demo/student-dashboard.html"
    },
    {
      "source": "/admin-dashboard",
      "destination": "/demo/admin-dashboard.html"
    },
    {
      "source": "/technical",
      "destination": "/demo/technical.html"
    },
    {
      "source": "/demo",
      "destination": "/demo/index.html"
    }
  ]
}
